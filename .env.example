# =============================================================================
# Drupal + Radicale CalDAV Stack - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=drupal
POSTGRES_USER=drupal
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Radicale CalDAV Server
# -----------------------------------------------------------------------------
RADICALE_ADMIN_USER=admin
# Generate a strong password: openssl rand -base64 32
RADICALE_ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Drupal Settings
# -----------------------------------------------------------------------------
# Generate hash salt: openssl rand -base64 64 | tr -d '\n'
DRUPAL_HASH_SALT=CHANGE_ME_GENERATE_RANDOM_HASH_SALT

# Trusted host pattern (your domain)
DRUPAL_TRUSTED_HOST=drupal.staging.chatthub.online

# -----------------------------------------------------------------------------
# Docker Registry (optional - for remote deployment)
# -----------------------------------------------------------------------------
# If pushing to a registry, set these:
# REGISTRY=your-registry.com/
# VERSION=1.0.0
